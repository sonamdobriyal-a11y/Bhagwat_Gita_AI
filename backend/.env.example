# Default: free local models via Ollama (https://ollama.com) — no API key.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: use OpenAI instead (paid / quota)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: use Google Gemini (paid / free tier)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

RAG_STORE_DIR=./data/rag_store
PDF_PATH=./data/bhagavad_gita.pdf
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
